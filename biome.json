{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/__tests__/**",
      "scripts/**",
      "examples/**",
      "!**/dist",
      "!spikes",
      "!**/__snapshots__",
      "!packages/sauf/__tests__/di",
      "!**/*.gen.ts",
      "!**/$types.d.ts"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": {
          "level": "warn",
          "fix": "none"
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noDoubleEquals": "warn",
        "noEmptyInterface": "warn",
        "noImplicitAnyLet": "warn",
        "noRedeclare": "warn",
        "noShadowRestrictedNames": "warn",
        "noThenProperty": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noVoidTypeReturn": "warn"
      }
    }
  }
}

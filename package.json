{
  "version": "0.5.4",
  "description": "Laratypes Framework",
  "private": false,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "vite": "^7.3.8",
      "hono": "^4.13.18",
      "zod": "^4.6.6"
    }
  },
  "overrides": {
    "@vue/compiler-core": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/shared": "3.5.44",
    "@babel/parser": "7.29.11",
    "@babel/helper-string-parser": "7.29.11",
    "postcss": "8.5.32",
    "source-map-js": "1.2.2",
    "nanoid": "3.3.20",
    "glob": "10.5.0",
    "minimatch": "9.0.9",
    "brace-expansion": "2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laratypes/Laratype.git"
  },
  "scripts": {
    "bench:types": "node scripts/bench-types/run.mjs",
    "build": "bun bun.build.js",
    "build:type": "tsc -p tsconfig.build.json && rollup -c rollup.dts.config.js",
    "check:dist": "node scripts/check-dist.mjs",
    "check:pkg": "node scripts/check-packages.mjs",
    "check:lint": "biome ci --diagnostic-level=error",
    "release:changeset": "node scripts/release/cli.js changeset",
    "release:check": "node scripts/release/cli.js check",
    "release:pre": "node scripts/release/cli.js pre",
    "release:pre-exit": "node scripts/release/cli.js pre-exit",
    "release:version": "node scripts/release/cli.js version",
    "test": "vitest",
    "test:di": "vitest run packages/sauf/__tests__/di"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@laratype/console": "workspace:*",
    "@laratype/support": "workspace:*",
    "deepmerge": "^4.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^20.11.24",
    "pkg-pr-new": "0.0.93",
    "publint": "^0.3.25",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "Ily1606",
  "license": "MIT"
}

{
  "name": "@laratype/support",
  "version": "0.5.4",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laratypes/Laratype.git",
    "directory": "packages/support"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Ily1606",
  "license": "MIT",
  "description": "Support module for laratype framework",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./*": "./*"
  },
  "buildOptions": {
    "external": [
      "dotenv"
    ]
  },
  "dependencies": {
    "@laratype/console": "workspace:*",
    "@laratype/core": "workspace:*",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "mlly": "^1.7.4",
    "ts-toolbelt": "^9.6.0"
  },
  "peerDependencies": {
    "dayjs": "^1.11.13",
    "typeorm": "^0.3.20",
    "hono": "^4.8.0",
    "@laratype/http": "workspace:*",
    "passport": "^0.7.0",
    "@types/passport": "^1.0.17"
  },
  "files": [
    "dist",
    "env.d.ts"
  ],
  "devDependencies": {
    "@laratype/http": "workspace:*",
    "@types/passport": "^1.0.17",
    "passport": "^0.7.0",
    "hono": "catalog:"
  },
  "peerDependenciesMeta": {
    "@laratype/http": {
      "optional": true
    },
    "passport": {
      "optional": true
    },
    "@types/passport": {
      "optional": true
    }
  }
}

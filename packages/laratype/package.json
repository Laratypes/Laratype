{
  "name": "laratype",
  "version": "0.5.4",
  "description": "Laratypes Core",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laratypes/Laratype.git",
    "directory": "packages/laratype"
  },
  "main": "./dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "dependencies": {
    "@laratype/console": "workspace:*",
    "@laratype/core": "workspace:*",
    "@laratype/support": "workspace:*"
  },
  "devDependencies": {
    "hono": "catalog:"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "Ily1606",
  "license": "MIT",
  "peerDependencies": {
    "hono": "^4.8.0",
    "@laratype/auth": "workspace:*",
    "@laratype/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@laratype/auth": {
      "optional": true
    },
    "@laratype/http": {
      "optional": true
    }
  }
}

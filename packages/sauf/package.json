{
  "name": "sauf",
  "version": "0.5.4",
  "private": false,
  "main": "./dist/index.cjs",
  "bin": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laratypes/Laratype.git",
    "directory": "packages/sauf"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rollup -c"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "keywords": [],
  "author": "Ily1606",
  "license": "MIT",
  "description": "Sauf command for laratype framework",
  "dependencies": {
    "@laratype/console": "workspace:*",
    "@laratype/support": "workspace:*",
    "@swc/core": "^1.16.20",
    "@swc/wasm": "^1.16.20",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.18",
    "oxc-parser": "^0.155.0",
    "tsc-alias": "^1.9.9",
    "vite": "^7.1.9",
    "@hono/node-server": "^1.19.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/pluginutils": "^5.5.1",
    "commander": "^13.1.0",
    "figlet": "^1.12.0",
    "handlebars": "^4.7.10",
    "kolorist": "^1.8.0",
    "rollup": "^4.65.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/figlet": "^1.7.0"
  },
  "buildOptions": {
    "banner": "#!/usr/bin/env node",
    "external": [
      "vite",
      "@swc/core",
      "@swc/wasm",
      "rollup",
      "tsc-alias",
      "jiti",
      "typescript"
    ]
  },
  "files": [
    "dist",
    "resources"
  ],
  "peerDependencies": {
    "@laratype/database": "workspace:*",
    "laratype": "workspace:*",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@laratype/database": {
      "optional": true
    },
    "laratype": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}

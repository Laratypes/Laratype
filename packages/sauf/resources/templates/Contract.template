import { defineContract, endpoint } from "@laratype/contract";
import * as z from "zod";
import type { Prefix } from "./$types";

// The folder tree gives this contract its URL prefix and name (docs/v1/contract.md › Contract folder tree).
const IndexQuery = z.object({
  page: z.coerce.number().int().min(1).default(1),
});

export default defineContract<Prefix>()({
  index: endpoint.get("/").query(IndexQuery),
});

import { Gate } from "@laratype/auth";
import type User from "../models/User";

/**
 * A gate for an ability with no model of its own (docs/v1/auth.md › Policies and gates): `true` allows, anything else
 * denies. Use the imported gate value, not its name: `import {{GateValue}} from "{{GateImportPath}}"`, then
 * `Gate.allows(user, {{GateValue}}, target)`; `Gate.authorize()` answers the 403 instead.
 */
export default Gate.define("{{GateName}}", (user: User, target: User) => user.id === target.id);

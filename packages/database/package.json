{
  "name": "@laratype/database",
  "version": "0.5.4",
  "private": false,
  "main": "./dist/index.cjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laratypes/Laratype.git",
    "directory": "packages/database"
  },
  "type": "module",
  "keywords": [],
  "author": "Ily1606",
  "license": "MIT",
  "description": "Database module for laratype framework",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "dependencies": {
    "@laratype/log": "workspace:*",
    "@laratype/support": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "buildOptions": {
    "external": [
      "typeorm"
    ]
  },
  "peerDependencies": {
    "typeorm": "^0.3.20"
  },
  "files": [
    "dist"
  ]
}
